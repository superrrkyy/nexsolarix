# NexSolarix environment example.
# Copy to .env.local and adjust. Every value below is optional.

# Owner Instagram handle used by the premium CTA (without the @).
VITE_INSTAGRAM_HANDLE=superryinz

# Secret used to sign premium licence keys.
# Leave empty to use the built-in demo secret (anyone reading the bundle could mint keys).
# For a private deploy: set this, then mint keys from /owner by typing the SAME secret there.
VITE_LICENSE_SECRET=

# Optional absolute site URL used for canonical/OG tags.
VITE_SITE_URL=

# Optional base path when hosting from a sub-folder, e.g. /nexsolarix/ for GitHub Pages.
VITE_BASE=/
